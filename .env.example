# ---------- Backend (Vercel → Settings → Environment Variables) ----------
# Private Integration Token de la subcuenta GHL de BNB390 (permisos: contacts, calendars, calendars/events)
GHL_TOKEN=
GHL_LOCATION_ID=
# Calendario de 60 minutos creado en GHL para BNB390
GHL_CALENDAR_ID=
# Firma de los tokens de reserva: cadena aleatoria de 32+ caracteres (p. ej. `openssl rand -hex 32`)
LEAD_TOKEN_SECRET=
# Opcional: IDs de campos personalizados de GHL para guardar cada respuesta en su campo.
# Claves posibles: q1_situacion q2_propiedades q3_facturacion q4_objetivo q5_freno q6_probado q7_inversion rango_estimado calificado city
GHL_FIELD_MAP={}

# ---------- Frontend (públicas) ----------
VITE_VSL_URL=
VITE_VSL_POSTER=
VITE_INSTAGRAM_URL=https://www.instagram.com/jaume.genovard
VITE_PRIVACY_URL=
# false en producción para ocultar las etiquetas "pendiente"
VITE_SHOW_PENDING=true
